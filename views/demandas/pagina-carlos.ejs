<body>
    <!-- Content -->

    <div class="container mt-5">
        <h1>Lista de Tarefas Disponíveis</h1>

        <!-- Tabela de Tarefas Disponíveis -->
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Nome da Tarefa</th>
                    <th>Descrição</th>
                    <th>Estimativa de Horas</th>
                    <th>Status</th>
                    <th>Data de Início</th>
                    <th>Data de Término Prevista</th>
                    <th>Atribuir Tarefa</th>
                </tr>
            </thead>
            <tbody>
                <% tasks.forEach(task => { %>
                <tr>
                    <td><%= task.nome %></td>
                    <td><%= task.descricao %></td>
                    <td><%= task.estimativa_horas %></td>
                    <td><%= task.status %></td>
                    <td><%= task.data_inicio %></td>
                    <td><%= task.data_termino_prevista %></td>
                    <td>
                        <form action="/atribuir-tarefa" method="POST">
                            <input type="hidden" name="taskId" value="<%= task.id %>">
                            <button type="submit" class="btn btn-primary">Pegar Tarefa</button>
                        </form>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>

        <!-- Tabela de Tarefas do Aluno -->
        <h2>Minhas Tarefas</h2>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Nome da Tarefa</th>
                    <th>Data de Início</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% myTasks.forEach(task => { %>
                <tr>
                    <td><%= task.nome %></td>
                    <td><%= task.data_inicio %></td>
                    <td><%= task.status %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>

    <!-- / Content -->

    <!-- Core JS -->
