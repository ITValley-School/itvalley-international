                }
              ],
              "conditional": null,
              "valid": true
            },
            "query": "select [email], [id], [senha] from [itv].[usuarios] where [itv].[usuarios].[email] = @p0",
            "orders": []
          }
        },
        "output": true,
        "meta": [
          {
            "type": "text",
            "name": "email"
          },
          {
