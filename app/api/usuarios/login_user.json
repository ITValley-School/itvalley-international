                "value": "{{$_POST.email}}",
                "test": ""
              }
            ],
            "table": {
              "name": "usuarios",
              "schema": "itv"
            },
            "primary": "id",
            "joins": [],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "id": "itv.usuarios.email",
                  "field": "itv.usuarios.email",
                  "type": "string",
                  "operator": "equal",
                  "value": "{{$_POST.email}}",
                  "data": {
