{
  "meta": {
    "$_POST": [
      {
        "type": "text",
        "options": {
          "rules": {
            "core:required": {},
            "core:email": {
              "message": "contato@itvalleyschool.com"
            }
          }
        },
        "name": "email"
      },
      {
        "type": "text",
        "options": {
          "rules": {
            "core:required": {}
          }
        },
        "name": "senha"
      }
    ]
  },
  "exec": {
    "steps": {
      "name": "identity",
      "module": "auth",
      "action": "login",
      "options": {
        "provider": "security_official",
        "username": "{{$_POST.email}}",
        "password": "{{$_POST.senha}}",
        "remember": ""
      },
      "output": true,
      "meta": []
    }
  }
}