{
  "meta": {
    "$_POST": [
      {
        "type": "text",
        "options": {
          "rules": {
            "core:required": {},
            "core:email": {
              "message": "contato@itvalleyschool.com"
            }
          }
        },
        "name": "email"
      },
      {
        "type": "text",
        "options": {
          "rules": {
            "core:required": {}
          }
        },
        "name": "senha"
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "identity",
        "module": "auth",
        "action": "login",
        "options": {
          "provider": "auth",
          "username": "{{$_POST.email}}",
          "password": "{{$_POST.senha}}",
          "remember": ""
        },
        "output": true,
        "meta": []
      },
      {
        "name": "",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{identity.logged_in}}",
          "then": {
            "steps": {
              "name": "",
              "module": "core",
              "action": "response",
              "options": {
                "status": 200,
                "data": "Você logou"
              }
            }
          }
        },
        "outputType": "boolean"
      },
      {
        "name": "",
        "module": "core",
        "action": "response",
        "options": {
          "status": 401,
          "data": "Erro no login"
        }
      }
    ]
  }
}