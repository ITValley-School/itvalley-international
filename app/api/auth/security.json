{
  "meta": {
    "$_POST": [
      {
        "type": "text",
        "name": "email"
      },
      {
        "type": "text",
        "name": "senha"
      },
      {
        "type": "text",
        "name": "lembreme"
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "identity",
        "module": "auth",
        "action": "login",
        "options": {
          "provider": "security_official",
          "username": "{{$_POST.email}}",
          "password": "{{$_POST.senha}}",
          "remember": "{{$_POST.lembreme}}"
        },
        "output": true,
        "meta": []
      },
      {
        "name": "",
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{identity}}",
          "then": {
            "steps": {
              "name": "",
              "module": "core",
              "action": "response",
              "options": {
                "status": 200,
                "data": "Logado"
              }
            }
          },
          "else": {
            "steps": {
              "name": "",
              "module": "core",
              "action": "response",
              "options": {
                "status": 401,
                "data": "Nao autenticado"
              }
            }
          }
        },
        "outputType": "boolean"
      }
    ]
  }
}